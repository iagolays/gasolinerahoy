// Despliegue en Cloudflare Workers con archivos estáticos (sin código de servidor).
// Lo usan `npx wrangler deploy` y el workflow .github/workflows/deploy.yml.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "gasolinerasya",
	"compatibility_date": "2026-10-19",
	"assets": {
		"directory": "./dist",
		"html_handling": "force-trailing-slash",
		"not_found_handling": "404-page"
	},
	// Dominio propio (zona gasolinerasya.es en esta cuenta de Cloudflare). La redirección www → raíz
	// se hace con una Redirect Rule de la zona, no aquí.
	"routes": [{ "pattern": "gasolinerasya.es", "custom_domain": true }]
}
