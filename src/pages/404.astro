---
// Página de error 404 (Cloudflare Pages sirve dist/404.html con estado 404).
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
---
<Base
  title="Página no encontrada"
  description={`La página que buscas no existe en ${SITE.name}. Busca tu provincia o las gasolineras más cercanas.`}
  path="/404.html"
  noindex
>
  <section class="prose notfound">
    <h1>No encontramos esta página</h1>
    <p class="lead">
      Puede que la dirección esté mal escrita o que la gasolinera haya dejado de comunicar sus precios al
      Ministerio y ya no aparezca.
    </p>
    <p class="actions">
      <a class="btn btn-primary" href="/cerca/">Gasolineras cerca de mí</a>
      <a class="btn" href="/#provincias">Ver provincias</a>
      <a class="btn" href="/">Ir a la portada</a>
    </p>
  </section>
</Base>

<style>
  .notfound {
    padding: 48px 0 24px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
